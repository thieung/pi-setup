#!/usr/bin/env bash
set -euo pipefail

# install.sh links this file into ~/.local/bin. BASH_SOURCE is that link, so
# dirname/.. would be ~/.local instead of this repo. macOS bash 3.2 has no readlink -f.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd -P)"
  LINK="$(readlink "$SOURCE")"
  if [[ "$LINK" == /* ]]; then
    SOURCE="$LINK"
  else
    SOURCE="$DIR/$LINK"
  fi
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd -P)"
COMMAND="${1:-}"
if [[ $# -gt 0 ]]; then shift; fi

case "$COMMAND" in
  sync)
    exec node "$ROOT/scripts/sync-source-extensions.mjs" "$@"
    ;;
  list)
    exec node "$ROOT/scripts/manage-profiles.mjs" list
    ;;
  add)
    exec node "$ROOT/scripts/manage-profiles.mjs" add "$@"
    ;;
  remove)
    exec node "$ROOT/scripts/manage-profiles.mjs" remove "$@"
    ;;
  doctor)
    exec node "$ROOT/scripts/doctor.mjs" "$@"
    ;;
  diff)
    exec node "$ROOT/scripts/diff-profiles.mjs" "$@"
    ;;
  "")
    echo "usage: pi-profile <profile|list|add|remove|sync|doctor|diff> [args...]" >&2
    exit 2
    ;;
  *)
    PROFILE="$COMMAND"
    if [[ ! -f "$ROOT/profiles/$PROFILE/profile.json" ]]; then
      echo "unknown profile: $PROFILE" >&2
      echo "available profiles:" >&2
      node "$ROOT/scripts/manage-profiles.mjs" list >&2
      exit 2
    fi
    ;;
esac

PROFILE_DIR="$HOME/.pi/profiles/$PROFILE"
node "$ROOT/scripts/materialize-profile.mjs" "$PROFILE" >/dev/null

export PI_PROFILE="$PROFILE"
export PI_CODING_AGENT_DIR="$PROFILE_DIR"
export PI_CODING_AGENT_SESSION_DIR="$PROFILE_DIR/sessions"

extra=()
while IFS= read -r ext; do
  [[ -z "$ext" ]] && continue
  if [[ -d "$ext" ]]; then
    extra+=("-e" "$ext")
  fi
done < <(
  node "$ROOT/scripts/render-profile.mjs" "$PROFILE" |
  node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const x=JSON.parse(s);for(const p of x.localExtensions||[])console.log(p)})'
)

exec pi ${extra[@]+"${extra[@]}"} "$@"
